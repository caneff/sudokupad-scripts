{
  "name": "sudokupad-scripts",
  "private": true,
  "scripts": {
    "test": "node --test \"test/**/*.test.*\" \"lib/**/*.test.js\" \"live/**/*.test.mjs\"",
    "test:live": "npm run test:live:files -- \"live/**/*.live.mjs\"",
    "test:live:files": "node --test --test-concurrency=4 --test-timeout=1200000",
    "test:fuzz": "node live/fuzz/run.mjs",
    "fuzz:plants": "node live/fuzz/plants-run.mjs",
    "fuzz:mutants": "node live/fuzz/mutants-run.mjs",
    "fuzz:nightly": "node live/fuzz/nightly.mjs",
    "test:fuzz:smoke": "node --test live/fuzz/fuzz.smoke.mjs",
    "watch:live": "node live/watch.mjs",
    "test:tampermonkey": "node --test --test-concurrency=1 \"live/**/*.tampermonkey.mjs\"",
    "lint": "standard"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "fast-check": "^4.10.2",
    "playwright": "^1.64.1",
    "standard": "^17.1.2"
  },
  "standard": {
    "//": "Framework is the global SudokuPad gives a userscript, and ToolLetter the one its letter tool declares. docs/research/ holds frozen scratch scripts from closed investigations; the gate never reads them.",
    "globals": [
      "Framework",
      "ToolLetter"
    ],
    "ignore": [
      "docs/research/**"
    ]
  }
}
